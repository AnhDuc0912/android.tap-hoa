<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/rootRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Ảnh sản phẩm -->
            <ImageView
                android:id="@+id/headphonesImage"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:scaleType="centerInside"
                android:src="@drawable/hango_logo" />

            <!-- Khối text + số lượng -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <!-- Tên -->
                <TextView
                    android:id="@+id/headphonesName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bánh Caro"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Giá -->
                <TextView
                    android:id="@+id/headphonesPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá: Đang cập nhật"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />

                <!-- Hàng số lượng (+ / - / qty) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số lượng:"
                        android:textColor="#555555"
                        android:textSize="14sp" />

                    <!-- Nút giảm -->
                    <ImageButton
                        android:id="@+id/btnDecrease"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/rounded_button_gray"
                        android:src="@drawable/ic_remove"
                        android:contentDescription="Giảm số lượng"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:backgroundTintMode="src_over" />

                    <!-- Số -->
                    <TextView
                        android:id="@+id/headphonesQuantity"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                    <!-- Nút tăng -->
                    <ImageButton
                        android:id="@+id/btnIncrease"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/rounded_button_blue"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Tăng số lượng"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:backgroundTintMode="src_over" />
                </LinearLayout>

                <!-- Mô tả -->
                <TextView
                    android:id="@+id/headphonesCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mô tả / Bánh kẹo"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Nút xoá -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="top|end">

                <ImageView
                    android:id="@+id/deleteHeadphonesButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_deletepng"
                    android:contentDescription="Xoá"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
